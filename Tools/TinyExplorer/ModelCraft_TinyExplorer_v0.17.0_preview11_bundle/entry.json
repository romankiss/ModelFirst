{
  "Design": {
    "declaration": {
      "name": "ModelCraft_microLAR_community",
      "version": "0.17.0_preview11",
      "type": "micro_lar_repository",
      "schema_version": "1.1.0",
      "title": "Tiny Light Explorer · community microLAR"
    },
    "purpose": "Portable private logical artifact repository; not an AI generation handoff.",
    "spaces": [
      {
        "id": "lib",
        "path": "lib/",
        "purpose": "Golden components; immutable catalog copies from the verified source pair."
      },
      {
        "id": "modules",
        "path": "modules/",
        "purpose": "Agile module Model-First artifacts, preserved with original filenames and references."
      },
      {
        "id": "package12",
        "path": "package12/",
        "purpose": "VERIFIED reusable Model/Code pairs; explicit foundation selection remains required."
      },
      {
        "id": "packages",
        "path": "packages/",
        "purpose": "Packages for examination and review, not automatically promoted to trained models."
      },
      {
        "id": "templates",
        "path": "templates/",
        "purpose": "Generic generation and handoff workflow templates."
      },
      {
        "id": "examples",
        "path": "examples/",
        "purpose": "Human tasks, teaching catalog and navigation documentation."
      },
      {
        "id": "tools",
        "path": "tools/",
        "purpose": "Supporting tools and future integration guidance."
      },
      {
        "id": "notices",
        "path": "notices/",
        "purpose": "Third-party notices for offline Explorer dependencies."
      },
      {
        "id": "rkb",
        "path": "rkb/",
        "purpose": "Sanitized runtime teaching projections; offline reference."
      }
    ],
    "policies": {
      "golden": "Immutable bytes, explicit origin and hash. Replacements stay in original generation/deployment contexts.",
      "pairs": "Explicit VERIFIED catalog; application compatibility assessed before use.",
      "examination": "packages/ inputs are not automatically promoted to trained state.",
      "future_LAR": "Stable identities, versions, hashes and origin references; no remote sync implemented."
    },
    "release_policy": {
      "state": "STABLE",
      "stable": "0.15.2",
      "retention": "Public distribution keeps the closed stable baseline and newest next-minor preview only. Development archives are separate. Pair-internal provenance/evidence are not Explorer preview history.",
      "community": "Read-only exploring/exporting plus scoped HAL-profile authoring. Other authoring remains deferred.",
      "current": "0.17.0_preview11"
    }
  },
